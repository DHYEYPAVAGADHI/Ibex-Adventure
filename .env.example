# ─── Database (Postgres / Supabase) ──────────────────────────────────────────
# Supabase: use the *session* pooler string on port 5432 — lib/prisma.ts
# auto-rewrites it to the transaction pooler (6543) for serverless.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres"

# ─── Admin panel (/admin) ────────────────────────────────────────────────────
ADMIN_EMAIL="admin@ibexadventure.in"
ADMIN_PASSWORD="change-me-to-a-strong-password"
# Secret used to sign the admin session token (openssl rand -base64 33)
JWT_SECRET="change-me-long-random-string"

# ─── Contact form email (optional — form still saves to DB without it) ────────
SMTP_HOST="smtpout.secureserver.net"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contact@ibexadventure.com"
SMTP_PASS="your-mailbox-password"
FROM_EMAIL="no-reply@ibexadventure.com"
CONTACT_EMAIL="contact@ibexadventure.com"

# ─── Supabase Storage (image uploads from the admin panel) ───────────────────
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ─── WhatsApp (falls back to the number in ContactInformation) ───────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
